# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto del servidor (Render asigna PORT automáticamente en producción)
# En desarrollo debe ser 3300: es el que espera Frontend/src/app/auth/environment/environment.ts
PORT=3300

# Credenciales de TiDB Cloud / MySQL
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=tu_usuario.root
DB_PASSWORD=tu_password_aqui
DB_NAME=dss_sadmg
DB_SSL=true

# Sesión (JWT). El secreto debe tener al menos 32 caracteres y NO se comparte ni se sube al repositorio.
# Para generar uno:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_esto_por_un_secreto_largo_y_aleatorio_de_32_o_mas_caracteres
# Vigencia del token: "8h", "7d" o segundos
JWT_EXPIRES_IN=8h
